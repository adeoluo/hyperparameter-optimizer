flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>optimize, evaluate"]:::edge
        Router["HTTP service<br/>/optimize /metrics"]:::core
        Validate["Validation<br/>trials 1 to 500"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph Study["Study loop (ask, tell)"]
        direction TB
        Ask["Study.ask<br/>unit-cube point"]:::core
        Space["Search space<br/>decode configuration"]:::core
        Objective["Benchmark objective<br/>Branin, Ackley, ..."]:::core
        Tell["Study.tell<br/>record the trial"]:::core
        History[("Trial history<br/>configs and values")]:::data
        Ask --> Space --> Objective --> Tell --> History
    end

    subgraph Samplers["Samplers"]
        direction TB
        Random["Random and Sobol<br/>space-filling"]:::core
        TPE["TPE<br/>Parzen density ratio"]:::core
        GP["Gaussian process<br/>Expected Improvement"]:::core
        Linalg["Cholesky solve<br/>linalg.py"]:::core
        Random ~~~ TPE ~~~ GP --> Linalg
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Result["Best configuration<br/>convergence curve"]:::obs
        Regret["Simple regret<br/>over 3 seeds"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Result --> Regret ~~~ Metrics
    end

    Interfaces -->|benchmark, sampler| Study
    Study -.->|trial history| Samplers
    Samplers -->|proposals| Study
    Study -->|best so far| Obs
